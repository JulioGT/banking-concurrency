# ═══════════════════════════════════════════════════════════
# CONFIGURACIÓN DE LA APLICACIÓN
# Copia este archivo a .env y ajusta los valores
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# SERVER
# ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ───────────────────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking
DB_USER=admin
DB_PASSWORD=secret123

# Connection Pool
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ───────────────────────────────────────────────────────────
# RETRY LOGIC
# ───────────────────────────────────────────────────────────
# Número máximo de reintentos en caso de conflicto
MAX_RETRIES=5

# Delay base para exponential backoff (ms)
RETRY_BASE_DELAY=50

# Delay máximo entre reintentos (ms)
RETRY_MAX_DELAY=1000

# ───────────────────────────────────────────────────────────
# TRANSACTION LIMITS
# ───────────────────────────────────────────────────────────
# Monto máximo para depósito en una sola transacción
MAX_DEPOSIT_AMOUNT=1000000

# Monto máximo para retiro en una sola transacción
MAX_WITHDRAW_AMOUNT=500000

# ───────────────────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_SQL_QUERIES=false

# ───────────────────────────────────────────────────────────
# PAGINATION
# ───────────────────────────────────────────────────────────
DEFAULT_PAGE_LIMIT=100
MAX_PAGE_LIMIT=1000

# ───────────────────────────────────────────────────────────
# TESTING
# ───────────────────────────────────────────────────────────
TEST_ACCOUNT_ID=123e4567-e89b-12d3-a456-426614174000
TEST_NUM_WORKERS=50
TEST_OPERATIONS_PER_WORKER=10
EOF